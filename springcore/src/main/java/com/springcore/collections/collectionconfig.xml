<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:p="http://www.springframework.org/schema/p"
	xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

	<bean id="Emp1" class="com.springcore.collections.Emp">
		<property name="name" value="Abhi" />
		<property name="phones">
			<list>
				<value>123</value>
				<value>456</value>
				<value>789</value>
			</list>
		</property>
		<property name="addresses">
			<set>
				<value>Mumbai</value>
				<value>Delhi</value>
				<value>Kanpur</value>
			</set>
		</property>

		<property name="courses">
			<map>
				<entry key="java" value="2Month" />
				<entry key="python" value="2Month" />
				<entry key="c" value="1Month" />
			</map>
		</property>
		  <property name="properties">
        <props>
            <prop key="url">jdbc:mysql://localhost:3306/mydb</prop>
            <prop key="username">root</prop>
            <prop key="password">root</prop>
        </props>
    </property>
	</bean>
</beans>
